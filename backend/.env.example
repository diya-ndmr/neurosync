# Copy to .env and set values for your local environment.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./neurosync.db
# Production: set these to your Supabase project URL and public anon/publishable key.
# Local development can keep using the database-login demo accounts without Supabase.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Optional: set both values only after configuring a restricted Moodle service.
# MOODLE_BASE_URL=http://localhost
# MOODLE_TOKEN=
